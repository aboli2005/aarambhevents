# --- Ticket e-mail: OPTIONAL. Leave all of this section out and tickets are not e-mailed (customers use "Find my ticket") ---
# MAIL_FROM_EMAIL=aarambheventmail@gmail.com
# MAIL_FROM_NAME=Aarambh Dandiya Nights
# Choose ONE of the two options below and leave the other one blank or delete it.
# Option A - FREE Render: Brevo (Render's free plan blocks normal e-mail/SMTP, so use this one)
# BREVO_API_KEY=
# Option B - PAID Render, or running on your own PC: Gmail SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=aarambheventmail@gmail.com
# SMTP_PASS=
# (SMTP_PASS = a 16-letter Gmail "App password", not the normal Gmail password)

